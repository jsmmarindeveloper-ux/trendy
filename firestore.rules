rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && (
        (request.auth.token.email == 'jsmmarindeveloper@gmail.com') ||
        (exists(/databases/$(database)/documents/superadmin/config) &&
         get(/databases/$(database)/documents/superadmin/config).data.super_admin_uid == request.auth.uid)
      );
    }

    function isTenantMember(tenantId) {
      return request.auth != null && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/tenant_usuarios/$(tenantId + '_' + request.auth.uid)) &&
         get(/databases/$(database)/documents/tenant_usuarios/$(tenantId + '_' + request.auth.uid)).data.activo == true)
      );
    }

    function isTenantAdmin(tenantId) {
      return request.auth != null && (
        isSuperAdmin() ||
        (isTenantMember(tenantId) &&
         get(/databases/$(database)/documents/tenant_usuarios/$(tenantId + '_' + request.auth.uid)).data.rol == 'admin')
      );
    }

    match /superadmin/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /competitor_products_cache/{sku} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isSuperAdmin() || resource.data.activo == true;
      allow write: if isTenantAdmin(tenantId) || isSuperAdmin();
    }

    match /tenant_usuarios/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /tenant_usuarios_pendientes/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /productos/{docId} {
      allow read: if resource.data.visible_catalogo == true
                  || isTenantMember(resource.data.tenant_id)
                  || isSuperAdmin();
      allow create: if request.auth != null && (isTenantMember(request.resource.data.tenant_id) || isSuperAdmin());
      allow update, delete: if isTenantMember(resource.data.tenant_id) || isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
